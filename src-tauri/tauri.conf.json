{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NanoKVM Control",
  "version": "0.5.0",
  "identifier": "io.github.cogarg.nanokvm-control",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libssl3"
        ]
      },
      "rpm": {
        "depends": [
          "openssl-libs"
        ]
      }
    }
  }
}
