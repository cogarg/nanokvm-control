{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "IPC access for the device-manager UI webview only. Console tabs/windows (remote NanoKVM pages, and the bundled VNC console page) get no IPC access.",
  "permissions": [
    "core:default",
    "allow-list-devices",
    "allow-get-settings",
    "allow-save-settings",
    "allow-export-devices",
    "allow-import-devices",
    "allow-local-networks",
    "allow-discover",
    "allow-list-groups",
    "allow-save-group",
    "allow-delete-group",
    "allow-save-device",
    "allow-delete-device",
    "allow-check-device",
    "allow-list-guests",
    "allow-open-tab",
    "allow-show-tab",
    "allow-close-tab",
    "allow-open-window",
    "allow-set-layout"
  ],
  "webviews": [
    "ui"
  ]
}
